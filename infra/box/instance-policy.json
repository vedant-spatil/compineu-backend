{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "EvidenceWriteNoDelete",
      "Effect": "Allow",
      "Action": ["s3:PutObject", "s3:PutObjectRetention", "s3:GetObject", "s3:GetObjectRetention", "s3:GetObjectVersion"],
      "Resource": "arn:aws:s3:::EVIDENCE_BUCKET/*"
    },
    {
      "Sid": "EvidenceList",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::EVIDENCE_BUCKET"
    },
    {
      "Sid": "NeverDeleteEvidence",
      "Effect": "Deny",
      "Action": ["s3:DeleteObject", "s3:DeleteObjectVersion", "s3:BypassGovernanceRetention", "s3:PutBucketObjectLockConfiguration"],
      "Resource": ["arn:aws:s3:::EVIDENCE_BUCKET", "arn:aws:s3:::EVIDENCE_BUCKET/*"]
    },
    {
      "Sid": "ReadDeployArtifacts",
      "Effect": "Allow",
      "Action": "s3:GetObject",
      "Resource": "arn:aws:s3:::ARTIFACTS_BUCKET/*"
    },
    {
      "Sid": "ReadOwnSecrets",
      "Effect": "Allow",
      "Action": ["ssm:GetParameter", "ssm:GetParameters", "ssm:GetParametersByPath"],
      "Resource": "arn:aws:ssm:REGION:ACCOUNT_ID:parameter/compineu/*"
    },
    {
      "Sid": "DecryptSecretsViaSsmOnly",
      "Effect": "Allow",
      "Action": "kms:Decrypt",
      "Resource": "*",
      "Condition": { "StringEquals": { "kms:ViaService": "ssm.REGION.amazonaws.com" } }
    },
    {
      "Sid": "LogsWrite",
      "Effect": "Allow",
      "Action": ["logs:CreateLogStream", "logs:PutLogEvents", "logs:DescribeLogStreams"],
      "Resource": "arn:aws:logs:REGION:ACCOUNT_ID:log-group:/compineu/prod:*"
    },
    {
      "Sid": "LogsQueryForObservabilityPage",
      "Effect": "Allow",
      "Action": ["logs:StartQuery", "logs:StopQuery", "logs:GetQueryResults", "logs:DescribeLogGroups"],
      "Resource": "*"
    },
    {
      "Sid": "HostMetricsFromCloudWatchAgent",
      "Effect": "Allow",
      "Action": "cloudwatch:PutMetricData",
      "Resource": "*",
      "Condition": { "StringEquals": { "cloudwatch:namespace": ["compineu/EC2"] } }
    }
  ]
}
