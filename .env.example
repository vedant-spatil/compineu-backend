# Copy to .env and fill in. Never commit .env. Names and placeholders only (plan.md section 23).

# --- LLM: Groq. Model names are Groq model IDs (set them from the Groq console). ---
# Groq free tier: about 8,000 tokens a minute per model.
LLM_PROVIDER=groq
GROQ_API_KEY=GROQ_API_KEY
LLM_MODEL_HEAVY=openai/gpt-oss-120b
LLM_MODEL_LIGHT=openai/gpt-oss-20b

# --- Database. Local: the Postgres container from docker-compose.yml. Production: set real values. ---
POSTGRES_PASSWORD=POSTGRES_PASSWORD
DATABASE_URL=postgresql+psycopg://aml:aml@localhost:5432/aml

PII_ENCRYPTION_KEY=

# --- Auth. Production: generate a real JWT_SECRET_KEY (32+ characters). ---
JWT_SECRET_KEY=replace-with-32-plus-random-bytes
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# --- Runtime ---
# dev locally. prod on EC2: the API refuses the dev JWT secret when APP_ENV=prod.
APP_ENV=dev
TRIAGE_THRESHOLD=0.6
# Frontend origin(s), comma separated. Production: the CloudFront URL.
CORS_ORIGINS=http://localhost:5173

# Admin observability page (CloudWatch Logs group the API writes to; empty = not configured)
OBSERVABILITY_LOG_GROUP=/policyguard/prod
OBSERVABILITY_REGION=ap-south-1

# CloudWatch for the containers (docker-compose.prod.yml awslogs driver) and scripts/aws/*.sh
AWS_REGION=ap-south-1
AWS_LOG_GROUP=/policyguard/prod

# Phase 2: AgentCore case runs. CASE_RUNNER=local keeps the workflow in the API process.
CASE_RUNNER=local
AGENTCORE_RUNTIME_ARN=
